generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id @default(auto()) @map("_id") @db.ObjectId
  user_id          Int        @unique
  name             String
  email            String     @unique
  password         String
  avatar           String?
  bio              String?
  role             String     @default("USER")
  address          String?
  phone            String?
  phoneCountryCode String?
  identityDocument String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  Place            Place[]
  Review           Review[]
  Favorite         Favorite[]
  Booking          Booking[]
  SentMessages     Message[]  @relation("SentMessages")
  ReceivedMessages Message[]  @relation("ReceivedMessages")
}

model Place {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  place_id          Int      @unique
  name              String
  description       String
  image             String
  images            String[]
  amenities         String[]
  category          String   @default("City")
  numberOfRooms     Int      @default(0)
  numberOfBathrooms Int      @default(0)
  maxGuests         Int      @default(0)
  priceByNight      Int      @default(0)
  totalUnits        Int      @default(1)
  latitude          Float?
  longitude         Float?
  hostId            Int
  cityId            Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  city     City       @relation(fields: [cityId], references: [city_id], onDelete: Cascade)
  host     User       @relation(fields: [hostId], references: [user_id], onDelete: Cascade)
  Review   Review[]
  Favorite Favorite[]
  Booking  Booking[]
  Message  Message[]
}

model City {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  city_id   Int      @unique
  name      String
  Place     Place[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Review {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  review_id   Int       @unique
  rating      Int
  comment     String
  userId      Int
  placeId     Int
  hostReply   String?
  hostReplyAt DateTime?
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [place_id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fav_id    Int      @unique
  userId    Int
  placeId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [place_id], onDelete: Cascade)

  @@unique([userId, placeId])
}

model Booking {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  booking_id Int      @unique
  userId     Int
  placeId    Int
  checkIn    DateTime
  checkOut   DateTime
  guests     Int
  totalPrice Int
  status     String   @default("pending")
  createdAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [place_id], onDelete: Cascade)
}

model Message {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  message_id Int      @unique
  senderId   Int
  receiverId Int
  placeId    Int?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User   @relation("SentMessages", fields: [senderId], references: [user_id], onDelete: Cascade)
  receiver User   @relation("ReceivedMessages", fields: [receiverId], references: [user_id], onDelete: Cascade)
  place    Place? @relation(fields: [placeId], references: [place_id], onDelete: Cascade)
}
